{
  "name": "@arcscord/adapter-i18next",
  "version": "0.1.0",
  "description": "i18next localization adapter for Arcscord.",
  "author": "Arcoz0308",
  "license": "MIT",
  "homepage": "https://arcscord.dev/packages/adapter-i18next",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arcscord/arcscord.git"
  },
  "bugs": {
    "url": "https://github.com/arcscord/arcscord/issues"
  },
  "keywords": ["arcscord", "discord", "i18next", "localization", "adapter"],
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.mjs",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.eslint.json",
    "docs": "typedoc"
  },
  "peerDependencies": {
    "arcscord": "workspace:^",
    "i18next": "^26.3.6"
  },
  "devDependencies": {
    "arcscord": "workspace:^",
    "i18next": "^26.4.2",
    "tsdown": "0.22.14",
    "typescript": "^6.0.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24.11.0",
    "bun": ">=1.3.0"
  },
  "files": ["dist/cjs/", "dist/esm/"]
}
