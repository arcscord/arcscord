{
  "name": "arcscord",
  "version": "1.2.0",
  "description": "A Discord.js framework with a slash-command-first, fully typed API.",
  "author": "Arcoz0308",
  "license": "MIT",
  "homepage": "https://arcscord.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arcscord/arcscord.git"
  },
  "bugs": {
    "url": "https://github.com/arcscord/arcscord/issues"
  },
  "keywords": [
    "discord",
    "framework",
    "discord.js",
    "arcscord",
    "typescript",
    "slash-commands",
    "typed-commands"
  ],
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.mjs",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/esm/testing/index.d.mts",
        "default": "./dist/esm/testing/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/testing/index.d.ts",
        "default": "./dist/cjs/testing/index.cjs"
      }
    }
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.eslint.json",
    "docs": "typedoc"
  },
  "dependencies": {
    "@arcscord/components": "workspace:^",
    "@arcscord/error": "workspace:^",
    "discord-api-types": "^0.38.51",
    "i18next": "^26.3.6"
  },
  "peerDependencies": {
    "discord.js": "^14.26.4",
    "typescript": "^5.4.0 || ^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "discord.js": "^14.27.0",
    "tsdown": "0.22.14",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.11.0",
    "bun": ">=1.3.0"
  },
  "files": [
    "dist/cjs/",
    "dist/esm/"
  ]
}
