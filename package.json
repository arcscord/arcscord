{
  "name": "@arcscord/arcscord",
  "private": true,
  "scripts": {
    "clean": "node scripts/workspace/clean.mts",
    "clean:full": "node scripts/workspace/clean.mts --dependencies",
    "build": "pnpm build:all && pnpm build:arcscord && pnpm build:adapters && pnpm build:webhooks && pnpm build:middleware",
    "build:all": "pnpm -r --filter='./packages/*' --filter='!./packages/{arcscord,adapter-i18next,adapter-paraglide,middleware,webhooks}' run build",
    "build:arcscord": "pnpm -r --filter='./packages/arcscord' run build",
    "build:adapters": "pnpm -r --filter='./packages/adapter-*' run build",
    "build:webhooks": "pnpm -r --filter='./packages/webhooks' run build",
    "build:middleware": "pnpm -r --filter='./packages/middleware' run build",
    "lint": "node scripts/ci/lint.mts",
    "knip": "knip",
    "typecheck": "pnpm typecheck:scripts && pnpm -r --parallel run typecheck",
    "typecheck:scripts": "tsc --project scripts/tsconfig.json --noEmit",
    "test": "node scripts/ci/test.mts",
    "test:test-bot": "pnpm -r --filter '@arcscord/test-bot' run start",
    "test:test-bot:bun": "pnpm --filter @arcscord/test-bot run start:bun",
    "test:components-bot": "pnpm --filter @arcscord/components-test-bot run start",
    "pack:local": "node scripts/compat/pack-local.mts",
    "test:bun": "pnpm pack:local && cd test/compat/bun-consumer && bun install --no-save && bun run typecheck && bun run smoke && bun test",
    "test:typescript-compat": "pnpm pack:local && cd test/compat/typescript-consumer && pnpm install --no-lockfile && pnpm typecheck",
    "test:node-compat": "pnpm pack:local && cd test/compat/node-consumer && pnpm install --no-lockfile && pnpm smoke:esm && pnpm smoke:cjs",
    "docs:api": "node scripts/docs/generate-api.mts --channel dev",
    "docs:api:release": "node scripts/docs/generate-api.mts --channel release",
    "docs:check-release": "node scripts/release/check-api-snapshots.mts",
    "docs:build": "pnpm docs:api && pnpm --filter @arcscord/website build",
    "docs:start": "pnpm docs:api && pnpm --filter @arcscord/website start",
    "prepare": "husky",
    "preinstall": "npx only-allow pnpm"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.3.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^24.13.4",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "knip": "^6.35.1",
    "lint-staged": "^17.5.1",
    "only-allow": "^1.2.2",
    "tsdown": "0.22.14",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vitest": "4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arcscord/arcscord.git"
  },
  "engines": {
    "node": ">=24.11.0",
    "bun": ">=1.3.0",
    "npm": ">=9.0.0"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "*": "eslint --fix --no-warn-ignored"
  },
  "packageManager": "pnpm@11.8.0"
}
