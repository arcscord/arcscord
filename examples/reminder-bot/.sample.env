# Your bot token
TOKEN=""

# Public key from the Discord Developer Portal (not the bot token).
DISCORD_PUBLIC_KEY=""

# Bind to loopback by default so the server is not exposed on your LAN.
WEBHOOK_HOST="127.0.0.1"

# Local port for POST /discord/webhooks.
WEBHOOK_PORT=3000

# Local SQLite file used by better-sqlite3.
DATABASE_PATH="./data/reminders.sqlite"
